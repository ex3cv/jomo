{
  "manifest_version": 3,
  "name": "JOMO",
  "version": "0.1.0",
  "description": "Joy of Missing Out. One click to let go of unpinned tabs.",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/jomo-16.png",
    "32": "icons/jomo-32.png",
    "48": "icons/jomo-48.png",
    "96": "icons/jomo-96.png"
  },
  "action": {
    "default_title": "JOMO — Let go of unpinned tabs",
    "default_icon": "icons/jomo.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jomo@extensions.local",
    "strict_min_version": "142.0",
      "update_url": "https://raw.githubusercontent.com/YOUR_USERNAME/jomo/main/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
